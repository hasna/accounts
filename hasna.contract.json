{
  "schema": "hasna.service_contract.v1",
  "name": "accounts",
  "class": "service",
  "contractVersion": "v1",
  "kitVersion": "0.8.2",
  "description": "Manage and switch between multiple AI coding tool profiles/accounts. Local mode keeps the registry in a JSON file at ~/.hasna/accounts/accounts.json (no embedded database engine); self_hosted/cloud modes use the authenticated accounts-serve HTTP API and PostgreSQL.",
  "bins": [
    "accounts",
    "accounts-mcp",
    "accounts-serve",
    "accounts-migrate"
  ],
  "deploymentModes": [
    "local",
    "self_hosted",
    "cloud"
  ],
  "hosting": [
    "user-hosted"
  ],
  "serviceSurfaces": [
    {
      "name": "accounts-api",
      "kind": "api",
      "status": "supported",
      "bin": "accounts-serve",
      "authMode": "api-key",
      "deploymentModes": [
        "self_hosted",
        "cloud"
      ],
      "health": {
        "method": "GET",
        "path": "/health",
        "public": true
      },
      "readiness": {
        "method": "GET",
        "path": "/ready",
        "public": true
      },
      "version": {
        "method": "GET",
        "path": "/version",
        "public": true
      },
      "apiBasePath": "/v1",
      "openApiPath": "/src/server/openapi.ts",
      "readinessGates": [
        {
          "id": "accounts-migrations",
          "kind": "migration",
          "required": true,
          "command": "accounts-migrate",
          "status": "pending"
        }
      ]
    },
    {
      "name": "accounts-sdk",
      "kind": "sdk",
      "status": "supported",
      "authMode": "api-key",
      "deploymentModes": [
        "self_hosted",
        "cloud"
      ],
      "exportSubpath": "./sdk",
      "generatedFrom": "/src/server/openapi.ts",
      "clientClassName": "AccountsClient"
    },
    {
      "name": "accounts-mcp",
      "kind": "mcp",
      "status": "supported",
      "mcpBin": "accounts-mcp",
      "authMode": "local-only",
      "deploymentModes": [
        "local"
      ]
    },
    {
      "name": "accounts-cli",
      "kind": "cli",
      "status": "supported",
      "bin": "accounts",
      "authMode": "local-only",
      "deploymentModes": [
        "local"
      ]
    }
  ],
  "storage": {
    "mode": "local",
    "engines": [
      "sqlite",
      "postgres"
    ],
    "envPrefix": "HASNA_ACCOUNTS_",
    "aliasEnvPrefix": "ACCOUNTS_",
    "pgTestGate": {
      "envVar": "HASNA_ACCOUNTS_TEST_DATABASE_URL",
      "command": "bun run test:postgres"
    }
  },
  "metadata": {
    "release": {
      "artifactScan": {
        "script": "scan:artifact"
      }
    },
    "storageNotes": {
      "sqlite": "Declared to satisfy the dual-engine storage_capabilities gate, which admits no waiver for class 'service'. This package ships no SQLite driver: the single-box store is the JSON registry named in `description`, and no `storage.sqlitePath` is declared because no .db file is ever created. Read this field before trusting `storage.engines` as a statement about the code."
    }
  }
}
