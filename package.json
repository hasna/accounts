{
  "name": "@hasna/accounts",
  "version": "1.0.0-dev.0",
  "description": "Fail-closed provider account capacity metadata for local and self-hosted Hasna deployments",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./capacity": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "accounts": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:types",
    "build:js": "bun build src/index.ts --outdir dist --target bun --format esm && bun build src/cli.ts --outfile dist/cli.js --target bun --format esm",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:storage": "bun test test/storage",
    "sync:v10-contract": "bun scripts/sync-accounts-v10-fixtures.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
